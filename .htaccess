DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Development sources are not public content. This is access control; the
    # matching robots.txt rules are only crawler guidance.
    RewriteRule ^(?:templates|scripts)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:package(?:-lock)?\.json|[^/]+\.md|\.gitignore)$ - [F,L,NC]
    RewriteRule ^(?:\.env(?:\.[^/]*)?|\.git|\.agents|\.codex|\.edge[^/]*)(?:/|$) - [F,L,NC]

    # Retire one stale WordPress gallery URL found in search results.
    RewriteRule ^type/gallery/?$ https://globalbirthdevelopers.com/gallery.html [R=301,L,NE,NC]

    # Collapse the duplicate homepage in one hop, including HTTP/www requests.
    # THE_REQUEST prevents DirectoryIndex's internal index.html lookup looping.
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]|$) [NC]
    RewriteRule ^index\.html$ https://globalbirthdevelopers.com/ [R=301,L,NE,NC]

    # Use one public origin: HTTPS and the non-www hostname. The fixed target
    # also avoids reflecting an unexpected Host header into a redirect.
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^globalbirthdevelopers\.com$ [NC]
    RewriteRule ^ https://globalbirthdevelopers.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 7 days"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType application/rss+xml "access plus 1 hour"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:html?|xml)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # These files are fetched as supporting resources, not standalone search
    # results. Their links still remain crawlable when rendered in public pages.
    <FilesMatch "^(?:404|header|footer|floating)\.html$">
        Header always set X-Robots-Tag "noindex, follow"
    </FilesMatch>
    <FilesMatch "^feed\.xml$">
        Header always set X-Robots-Tag "noindex, follow"
    </FilesMatch>
</IfModule>

AddDefaultCharset UTF-8
